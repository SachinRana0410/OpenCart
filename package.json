    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "allure-playwright": "^3.14.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.74.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  }
